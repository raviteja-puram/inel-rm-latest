# Durable hosted persistence
PERSISTENCE_MODE=postgres-sync
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Evening operations digest (default send time: 17:30 local server time)
DAILY_MAIL_TIME=17:30
DAILY_MAIL_TO=planning@example.com,purchase@example.com

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=inel-rm@example.com
